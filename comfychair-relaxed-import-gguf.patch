@@ -0,0 +1,57 @@
+package sh.hnet.comfychair.storage
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * The prompts of submitted jobs, newest first, from every generation screen: kept on the device so a prompt can be
+ * used again. A prompt submitted again moves to the top instead of being listed twice.
+ */
+class PromptHistoryStorage(context: Context) {
+    private val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+
+    /** A submitted prompt, the screen it was submitted from (its owner ID) and when. */
+    data class Entry(val prompt: String, val ownerId: String, val time: Long)
+
+    companion object {
+        const val PREFS_NAME = "PromptHistoryPrefs"
+        private const val KEY_ENTRIES = "entries"
+        const val MAX_ENTRIES = 200
+    }
+
+    fun entries(): List<Entry> {
+        val json = prefs.getString(KEY_ENTRIES, null) ?: return emptyList()
+        return try {
+            val array = JSONArray(json)
+            (0 until array.length()).mapNotNull { i ->
+                val o = array.optJSONObject(i) ?: return@mapNotNull null
+                val prompt = o.optString("prompt")
+                if (prompt.isBlank()) null else Entry(prompt, o.optString("owner"), o.optLong("time"))
+            }
+        } catch (_: Exception) {
+            emptyList()
+        }
+    }
+
+    @Synchronized
+    fun record(prompt: String, ownerId: String) {
+        if (prompt.isBlank()) return
+        val entries = listOf(Entry(prompt, ownerId, System.currentTimeMillis())) +
+            entries().filterNot { it.prompt == prompt }
+        save(entries.take(MAX_ENTRIES))
+    }
+
+    @Synchronized
+    fun remove(prompt: String) = save(entries().filterNot { it.prompt == prompt })
+
+    fun clear() {
+        prefs.edit().remove(KEY_ENTRIES).apply()
+    }
+
+    private fun save(entries: List<Entry>) {
+        val array = JSONArray()
+        entries.forEach { array.put(JSONObject().put("prompt", it.prompt).put("owner", it.ownerId).put("time", it.time)) }
+        prefs.edit().putString(KEY_ENTRIES, array.toString()).apply()
+    }
+}
