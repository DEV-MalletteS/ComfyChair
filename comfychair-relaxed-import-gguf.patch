+            if (node.optString("class_type") in classTypes) removed.add(id)
+        }
+        removed.forEach { nodes.remove(it) }
+        for (id in nodes.keys()) {
+            val inputs = nodes.optJSONObject(id)?.optJSONObject("inputs") ?: continue
+            val dangling = inputs.keys().asSequence().filter { key ->
