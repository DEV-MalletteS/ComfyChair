+    /**
+     * Make each model loader match the file picked in it: a .gguf in a standard loader turns it into its GGUF twin,
+     * a non-GGUF file in a GGUF loader turns it back. Swaps only when the target node exists on the server.
+     */
+    private fun swapGgufLoaders(processedJson: String): String {
+        if (!processedJson.contains("class_type")) return processedJson
+        return try {
+            val json = JSONObject(processedJson)
+            val nodes = json.optJSONObject("nodes") ?: json
+            val registry = ConnectionManager.nodeTypeRegistry
+            val reverse = GGUF_TWINS.entries.associate { it.value to it.key }
+            for (id in nodes.keys()) {
+                val node = nodes.optJSONObject(id) ?: continue
+                val inputs = node.optJSONObject("inputs") ?: continue
+                val cls = node.optString("class_type")
+                val fileKeys = inputs.keys().asSequence().filter { it == "unet_name" || it.startsWith("clip_name") }.toList()
+                val values = fileKeys.mapNotNull { inputs.optString(it, null) }.filter { it.isNotEmpty() && !it.startsWith("{{") }
+                if (values.isEmpty()) continue
+                val anyGguf = values.any { it.endsWith(".gguf", ignoreCase = true) }
+                val target = when {
+                    anyGguf && cls in GGUF_TWINS -> GGUF_TWINS.getValue(cls)
+                    !anyGguf && cls in reverse -> reverse.getValue(cls)
+                    else -> continue
+                }
+                if (registry.getNodeDefinition(target) == null) continue
+                node.put("class_type", target)
+                if (target in reverse) STANDARD_ONLY_INPUTS.forEach { inputs.remove(it) }
+                else if (target == "UNETLoader" && !inputs.has("weight_dtype")) inputs.put("weight_dtype", "default")
+                DebugLogger.i(TAG, "Loader swapped: $cls -> $target")
+            }
+            json.toString()
+        } catch (e: Exception) {
+            processedJson
+        }
+    }
