+
+/** A section of a MiniMax H3 prompt: its heading in the prompt and its label in the builder. */
+private class H3Section(val heading: String, val labelRes: Int, val hintRes: Int, val minLines: Int = 2)
+
+/** REF2VA (reference to video): the six sections, each heading on its own line, as MiniMax H3 reads them. */
+private val REF_SECTIONS = listOf(
+    H3Section("subject_definitions", R.string.label_h3_subjects, R.string.hint_h3_subjects),
+    H3Section("summary", R.string.label_h3_summary, R.string.hint_h3_summary),
+    H3Section("retention_analysis", R.string.label_h3_retention, R.string.hint_h3_retention),
+    H3Section("detailed_description", R.string.label_h3_detail, R.string.hint_h3_detail, minLines = 5),
+    H3Section("overall_soundscape", R.string.label_h3_soundscape, R.string.hint_h3_soundscape),
+    H3Section("non_diegetic_music", R.string.label_h3_music, R.string.hint_h3_music)
+)
+
+/** Text, image or first/last frame to video: three sections, each heading followed by its text on the same line. */
+private val BASE_SECTIONS = listOf(
+    H3Section("integrated_multimodal_description", R.string.label_h3_description, R.string.hint_h3_description, minLines = 5),
+    H3Section("overall_soundscape", R.string.label_h3_soundscape, R.string.hint_h3_soundscape),
+    H3Section("non_diegetic_music", R.string.label_h3_music, R.string.hint_h3_music)
+)
+
+/** The first frame line of image to video: <Picture 1> (the source image) at the start of the video. */
+private const val FIRST_FRAME_LINE =
+    "For the target video, at 0.00 seconds into the target video, <Picture 1> (from [Shot 1]) is fully referenced."
+
+/**
+ * The sections of [prompt] when it's laid out as an H3 prompt ("heading:" then its text), by heading; empty when it
+ * isn't, so the builder starts from scratch.
+ */
+private fun parseSections(prompt: String, sections: List<H3Section>): Map<String, String> {
+    val headings = sections.map { it.heading }
+    val pattern = Regex("(?m)^(${headings.joinToString("|")}):[ \\t]*")
+    val matches = pattern.findAll(prompt).toList()
+    return matches.mapIndexed { i, match ->
+        val end = if (i + 1 < matches.size) matches[i + 1].range.first else prompt.length
+        match.groupValues[1] to prompt.substring(match.range.last + 1, end).trim()
+    }.toMap()
+}
+
+/** The prompt from the builder's fields, in MiniMax H3's layout; empty music is "N/A". */
+private fun buildH3Prompt(reference: Boolean, values: Map<String, String>, firstFrame: Boolean): String {
+    fun value(heading: String) = values[heading].orEmpty().trim().let {
+        if (it.isEmpty() && heading == "non_diegetic_music") "N/A" else it
+    }
+    return if (reference) {
+        REF_SECTIONS.joinToString("\n\n") { "${it.heading}:\n${value(it.heading)}" }
+    } else {
+        val body = BASE_SECTIONS.joinToString("\n\n") { "${it.heading}: ${value(it.heading)}" }
+        if (firstFrame) "$FIRST_FRAME_LINE\n\n$body" else body
+    }
+}
+
+/**
+ * A form for MiniMax H3's structured prompt: Reference to Video's six sections, or the three of text and image to
+ * video, put together in the layout the model was trained on. Opens on [prompt]'s sections when it's laid out that way.
+ *
+ * @param referenceMode Starts on the reference layout (Reference to Video), else the base one
+ */
+@OptIn(ExperimentalMaterial3ExpressiveApi::class)
+@Composable
+fun H3PromptBuilderDialog(prompt: String, referenceMode: Boolean, onApply: (String) -> Unit, onDismiss: () -> Unit) {
+    var reference by remember { mutableStateOf(referenceMode) }
+    var firstFrame by remember { mutableStateOf(prompt.startsWith(FIRST_FRAME_LINE)) }
+    val values = remember {
+        mutableStateOf(parseSections(prompt, REF_SECTIONS) + parseSections(prompt, BASE_SECTIONS))
+    }
+    val sections = if (reference) REF_SECTIONS else BASE_SECTIONS
+
+    ToolDialog(
+        title = stringResource(R.string.title_h3_builder),
+        onDismiss = onDismiss,
+        actions = {
+            Spacer(Modifier.weight(1f))
+            Button(
+                onClick = {
+                    onApply(buildH3Prompt(reference, values.value, firstFrame))
+                    onDismiss()
+                },
+                modifier = Modifier.height(48.dp)
+            ) { Text(stringResource(R.string.button_h3_builder_apply)) }
+        }
+    ) {
+        Column(
+            Modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .padding(horizontal = 16.dp)
+        ) {
+            Row(horizontalArrangement = Arrangement.spacedBy(ButtonGroupDefaults.ConnectedSpaceBetween)) {
+                ToggleButton(
+                    checked = reference,
+                    onCheckedChange = { if (it) reference = true },
+                    shapes = ButtonGroupDefaults.connectedLeadingButtonShapes()
+                ) { Text(stringResource(R.string.label_h3_mode_reference)) }
+                ToggleButton(
+                    checked = !reference,
+                    onCheckedChange = { if (it) reference = false },
+                    shapes = ButtonGroupDefaults.connectedTrailingButtonShapes()
+                ) { Text(stringResource(R.string.label_h3_mode_base)) }
+            }
+            Text(
+                stringResource(if (reference) R.string.desc_h3_mode_reference else R.string.desc_h3_mode_base),
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.onSurfaceVariant,
+                modifier = Modifier.padding(vertical = 8.dp)
+            )
+            if (!reference) {
+                Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.fillMaxWidth()) {
+                    Text(stringResource(R.string.label_h3_first_frame), modifier = Modifier.weight(1f))
+                    Switch(checked = firstFrame, onCheckedChange = { firstFrame = it })
+                }
+            }
+            sections.forEach { section ->
+                OutlinedTextField(
+                    value = values.value[section.heading].orEmpty(),
+                    onValueChange = { text -> values.value = values.value + (section.heading to text) },
+                    label = { Text(stringResource(section.labelRes)) },
+                    placeholder = { Text(stringResource(section.hintRes)) },
+                    minLines = section.minLines,
+                    modifier = Modifier.fillMaxWidth().heightIn(min = 56.dp).padding(vertical = 4.dp)
+                )
+            }
+            Spacer(Modifier.height(16.dp))
+        }
+    }
+}
