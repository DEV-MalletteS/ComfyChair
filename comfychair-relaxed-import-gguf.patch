+    /** The reference groups of MiniMaxH3ReferenceToVideo (ComfyUI core), as an API prompt keys them: "group.slot". */
+    private val REFERENCE_GROUPS = listOf("ref_images", "ref_videos", "ref_video_audios", "ref_audios")
+    /** A reference slot without its group (a numbered slot only: ref_image_size is a setting, not a slot). */
+    private val REFERENCE_SLOT = Regex("^ref_(image|video|video_audio|audio)_\\d+$")
+
+    /** Longest part of a reference video that is read: MiniMax H3 takes 2-15 s of a reference video. */
+    private const val REFERENCE_VIDEO_SECONDS = 15.0
+
+    /**
+     * Wire [references] into every MiniMaxH3ReferenceToVideo node, in place of the references the workflow came with:
+     * - an image: LoadImage -> ref_images.ref_image_N
+     * - a video: LoadVideo -> Video Slice (first 15 s) -> GetVideoComponents; its frames -> ref_videos.ref_video_N and,
+     *   with its sound, its audio -> ref_video_audios.ref_video_audio_N (paired by number, as the node pairs them)
+     * - an audio clip: LoadAudio -> ref_audios.ref_audio_N
+     * Slots count from 0 within each kind; the node presents images, then videos (each soundtrack before its video),
+     * then standalone audio, which is how the screen numbers the <Picture N>, <Video N> and <Audio N> tags.
+     * The workflow's former reference loaders stay, unconnected, and so don't run.
+     */
+    private fun injectReferences(processedJson: String, references: List<WorkflowReference>): String {
+        return try {
+            val root = JSONObject(processedJson)
+            val nodes = root.optJSONObject("nodes") ?: root
+            val targets = nodes.keys().asSequence()
+                .filter { WorkflowJsonAnalyzer.isReferenceToVideoNode(nodes.optJSONObject(it)?.optString("class_type") ?: "") }
+                .toList()
+            if (targets.isEmpty()) {
+                DebugLogger.w(TAG, "Reference to Video: no MiniMaxH3ReferenceToVideo node in the workflow")
+                return processedJson
+            }
+
+            fun link(nodeId: String, output: Int) = JSONArray().put(nodeId).put(output)
+            fun node(classType: String, inputs: JSONObject) = JSONObject().put("class_type", classType).put("inputs", inputs)
+
+            val wiring = linkedMapOf<String, JSONArray>()
+            var images = 0
+            var videos = 0
+            var audios = 0
+            for (ref in references) {
+                when (ref.kind) {
+                    ReferenceKind.IMAGE -> {
+                        val id = "r2v_image_$images"
+                        nodes.put(id, node("LoadImage", JSONObject().put("image", ref.filename)))
+                        wiring["ref_images.ref_image_$images"] = link(id, 0)
+                        images++
+                    }
+                    ReferenceKind.VIDEO -> {
+                        val load = "r2v_video_$videos"
+                        val slice = "r2v_video_slice_$videos"
+                        val parts = "r2v_video_parts_$videos"
+                        nodes.put(load, node("LoadVideo", JSONObject().put("file", ref.filename)))
+                        nodes.put(slice, node("Video Slice", JSONObject()
+                            .put("video", link(load, 0))
+                            .put("start_time", 0.0)
+                            .put("duration", REFERENCE_VIDEO_SECONDS)
+                            .put("strict_duration", false)))
+                        nodes.put(parts, node("GetVideoComponents", JSONObject().put("video", link(slice, 0))))
+                        wiring["ref_videos.ref_video_$videos"] = link(parts, 0)
+                        if (ref.withSound) wiring["ref_video_audios.ref_video_audio_$videos"] = link(parts, 1)
+                        videos++
+                    }
+                    ReferenceKind.AUDIO -> {
+                        val id = "r2v_audio_$audios"
+                        nodes.put(id, node("LoadAudio", JSONObject().put("audio", ref.filename)))
+                        wiring["ref_audios.ref_audio_$audios"] = link(id, 0)
+                        audios++
+                    }
+                }
+            }
+
+            for (target in targets) {
+                val inputs = nodes.optJSONObject(target)?.optJSONObject("inputs") ?: continue
+                // The workflow's own references give way to the chosen ones
+                inputs.keys().asSequence()
+                    .filter { key -> REFERENCE_GROUPS.any { key.startsWith("$it.") } || REFERENCE_SLOT.matches(key) }
+                    .toList()
+                    .forEach { inputs.remove(it) }
+                wiring.forEach { (key, source) -> inputs.put(key, source) }
+            }
+            DebugLogger.i(TAG, "Reference to Video: $images image(s), $videos video(s), $audios audio clip(s) wired " +
+                "into ${targets.size} node(s)")
+            root.toString()
+        } catch (e: Exception) {
+            DebugLogger.e(TAG, "Reference to Video: references not wired: ${Obfuscator.error(e)}")
+            processedJson
+        }
+    }
