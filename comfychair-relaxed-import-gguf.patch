+/**
+ * Reference to Video (MiniMax H3 ref2va): images, videos and audio clips as references, each with the tag that names
+ * it in the prompt. The workflow's MiniMaxH3ReferenceToVideo node gets them when generating.
+ */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+fun ReferenceToVideoScreen(
+    generationViewModel: GenerationViewModel,
+    referenceToVideoViewModel: ReferenceToVideoViewModel,
+    onUseAsSource: UseAsSource,
+    presetViewModel: PromptPresetViewModel = viewModel()
+) {
+    val context = LocalContext.current
+    val lifecycleOwner = LocalLifecycleOwner.current
+    val ownerId = ReferenceToVideoViewModel.OWNER_ID
+
+    val uiState by referenceToVideoViewModel.uiState.collectAsState()
+    val presetUiState by presetViewModel.uiState.collectAsState()
+    val queueState by JobRegistry.queueState.collectAsState()
+
+    GenerationScreenEffects(
+        referenceToVideoViewModel, generationViewModel, presetViewModel, ScreenType.REFERENCE_TO_VIDEO, ownerId,
+        onJobStarted = { referenceToVideoViewModel.onViewModeChange(ReferenceToVideoViewMode.PREVIEW) }
+    )
+    val promptInput = rememberPromptInputState()
+    var showOptionsSheet by remember { mutableStateOf(false) }
+
+    val isThisScreenExecuting = queueState.executingOwnerId == ownerId
+    val showResults = !isThisScreenExecuting && uiState.generationOutputs.size > 1
+    val isThisScreenQueued = !isThisScreenExecuting && queueState.hasWaitingJob(ownerId)
+    val videoUri = uiState.currentVideoUri
+    val previewBitmap = uiState.previewBitmap
+    val references = uiState.references
+    val hasVisualReference = references.any { it.kind != ReferenceKind.AUDIO }
+
+    // Video plays only while the screen is resumed, so it doesn't render over navigation transitions
+    var isScreenVisible by remember { mutableStateOf(true) }
+    DisposableEffect(lifecycleOwner) {
+        val observer = LifecycleEventObserver { _, event ->
+            isScreenVisible = event.targetState.isAtLeast(Lifecycle.State.RESUMED)
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
+    }
+
+    // One picker per kind of reference, from the device
+    val pickImage = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+        if (uri != null) referenceToVideoViewModel.addReference(context, uri, ReferenceKind.IMAGE)
+    }
+    val pickVideo = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+        if (uri != null) referenceToVideoViewModel.addReference(context, uri, ReferenceKind.VIDEO)
+    }
+    val pickAudio = rememberLauncherForActivityResult(ActivityResultContracts.GetContent()) { uri ->
+        if (uri != null) referenceToVideoViewModel.addReference(context, uri, ReferenceKind.AUDIO)
+    }
+
+    val mediaViewer = LocalMediaViewer.current
+
+    val submitJob = rememberJobSubmitter(
+        generationViewModel = generationViewModel,
+        ownerId = ownerId,
+        describeJob = { JobDescription(uiState.positivePrompt, uiState.selectedWorkflow) },
+        prepareWorkflow = { referenceToVideoViewModel.prepareWorkflow() },
+        contentType = ContentType.VIDEO
+    )
+
+    Column(modifier = Modifier.fillMaxSize()) {
+        GenerationTopBar(
+            screen = MainRoute.ReferenceToVideo,
+            ownerId = ownerId,
+            generationViewModel = generationViewModel
+        )
+
+        val firstThumbnail = references.firstNotNullOfOrNull { it.thumbnail }
+        val sourceThumb = remember(firstThumbnail) { firstThumbnail?.asImageBitmap() }
+        val liveThumb = remember(previewBitmap) { previewBitmap?.asImageBitmap() }
+        val outputThumb = rememberOutputThumbnail(uiState.generationOutputs.getOrNull(uiState.currentResultIndex).takeIf { showResults })
+        val videoFrame = rememberVideoFrame(videoUri.takeIf { !showResults }, sizeDp = 180.dp)
+        val resultThumb = liveThumb ?: (if (showResults) outputThumb else videoFrame)
+
+        GenerationPreviewArea {
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .heightIn(min = 150.dp)
+                    .background(MaterialTheme.colorScheme.surfaceContainer)
+                    .clickable(
+                        enabled = uiState.viewMode == ReferenceToVideoViewMode.PREVIEW && videoUri != null && !showResults,
+                        onClick = { videoUri?.let { uri -> mediaViewer.openVideo(uri, originKey = VIDEO_ORIGIN) } }
+                    ),
+                contentAlignment = Alignment.Center
+            ) {
+                SourceResultSwitcher(
+                    showSource = uiState.viewMode == ReferenceToVideoViewMode.SOURCE,
+                    onShowSourceChange = { showSource ->
+                        referenceToVideoViewModel.onViewModeChange(
+                            if (showSource) ReferenceToVideoViewMode.SOURCE else ReferenceToVideoViewMode.PREVIEW
+                        )
+                    },
+                    sourceThumb = sourceThumb,
+                    resultThumb = resultThumb,
+                    source = { _ ->
+                        ReferencePanel(
+                            references = references,
+                            onAddImage = { pickImage.launch("image/*") },
+                            onAddVideo = { pickVideo.launch("video/*") },
+                            onAddAudio = { pickAudio.launch("audio/*") },
+                            onInsertTag = referenceToVideoViewModel::insertTag,
+                            onRemove = referenceToVideoViewModel::removeReference,
+                            onSoundChange = referenceToVideoViewModel::onReferenceSoundChange
+                        )
+                    },
+                    result = { inTransition ->
+                        when {
+                            showResults -> {
+                                val results = uiState.generationOutputs
+                                val openViewer = rememberResultsViewer(results, referenceToVideoViewModel::onCurrentResultChange)
+                                val firstVideo = results.firstOrNull { it.isVideo }
+                                ResultsPreview(
+                                    results = results,
+                                    currentIndex = uiState.currentResultIndex,
+                                    onCurrentIndexChange = referenceToVideoViewModel::onCurrentResultChange,
+                                    onOpenViewer = openViewer,
+                                    stripEnabled = !isThisScreenQueued,
+                                    heroOverlay = { current ->
+                                        key(current.id) {
+                                            ResultActionsMenu(
+                                                media = ResultMedia.output(current, VideoUtils.GalleryPrefix.REFERENCE_TO_VIDEO),
+                                                sendActions = resultSendActions(onUseAsSource, current) { loadResultBitmap(current) },
+                                                resultNumber = results.indexOf(current) + 1
+                                            )
+                                        }
+                                    }
+                                ) { output, isCurrent ->
+                                    if (output.isVideo) {
+                                        ResultHeroVideo(
+                                            output = output,
+                                            isCurrent = isCurrent,
+                                            isActive = isScreenVisible && !inTransition,
+                                            preloadedUri = videoUri.takeIf { output == firstVideo }
+                                        )
+                                    } else {
+                                        ResultHeroImage(output)
+                                    }
+                                }
+                            }
+                            previewBitmap != null -> {
+                                Image(
+                                    bitmap = previewBitmap.asImageBitmap(),
+                                    contentDescription = stringResource(R.string.content_description_preview),
+                                    modifier = Modifier.fillMaxSize(),
+                                    contentScale = ContentScale.Crop
+                                )
+                            }
+                            videoUri != null -> {
+                                VideoPlayer(
+                                    videoUri = videoUri,
+                                    modifier = Modifier.fillMaxSize(),
+                                    isActive = isScreenVisible && !inTransition,
+                                    showPlaybackStatus = true,
+                                    placeholder = videoFrame?.asAndroidBitmap(),
+                                    originKey = VIDEO_ORIGIN,
+                                    originCorner = 28.dp
+                                )
+                                ResultActionsMenu(
+                                    media = ResultMedia.video(videoUri, VideoUtils.GalleryPrefix.REFERENCE_TO_VIDEO),
+                                    sendActions = videoSendActions(onUseAsSource) { readShownVideo(context, videoUri) }
+                                )
+                            }
+                            else -> {
+                                EmptyResultState()
+                            }
+                        }
+                        ScreenJobStatus(ownerId, generationViewModel)
+                    }
+                )
+            }
+        }
+
+        PromptDock(
+            state = uiState,
+            onPositiveChange = referenceToVideoViewModel::onPositivePromptChange,
+            onNegativeChange = referenceToVideoViewModel::onNegativePromptChange,
+            preview = uiState.previewBitmap ?: firstThumbnail,
+            presetViewModel = presetViewModel,
+            presetUiState = presetUiState,
+            spellCheckEnabled = promptInput.spellCheckEnabled,
+            generateEnabled = referenceToVideoViewModel.hasValidConfiguration(),
+            onGenerate = { submitJob(false) }
+        )
+
+        RecipeChips(
+            state = uiState,
+            viewModel = referenceToVideoViewModel,
+            icon = WorkflowIcons.default,
+            groups = singleWorkflowGroup(uiState.availableWorkflows, referenceToVideoViewModel::onWorkflowChange)
+        )
+
+        GenerationControls(
+            missingSource = !hasVisualReference,
+            isEnabled = referenceToVideoViewModel.hasValidConfiguration(),
+            generationViewModel = generationViewModel,
+            ownerId = ownerId,
+            hasPositivePrompt = uiState.capabilities.hasPositivePrompt,
+            isFetching = uiState.isFetching,
+            optionsOpen = showOptionsSheet,
+            onOpenOptions = { showOptionsSheet = true },
+            isUploading = uiState.isUploading,
+            submit = submitJob
+        )
+    }
+
+    GenerationOptionsSheet(
+        visible = showOptionsSheet,
+        onDismiss = { showOptionsSheet = false },
+        viewModel = referenceToVideoViewModel,
+        state = uiState
+    ) { callbacks -> uiState.toBottomSheetConfig(callbacks) }
+
+    PromptPresetDialogs(presetViewModel, presetUiState, uiState.positivePrompt)
+}
+
+/** The references with their tags, and a button per kind to add one. */
+@Composable
+private fun ReferencePanel(
+    references: List<ReferenceItem>,
+    onAddImage: () -> Unit,
+    onAddVideo: () -> Unit,
+    onAddAudio: () -> Unit,
+    onInsertTag: (ReferenceItem) -> Unit,
+    onRemove: (String) -> Unit,
+    onSoundChange: (String, Boolean) -> Unit
+) {
+    val tags = remember(references) { references.tags() }
+    Column(modifier = Modifier.fillMaxSize().padding(12.dp)) {
+        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            AddButton(Icons.Rounded.AddPhotoAlternate, R.string.button_add_image_reference, onAddImage, Modifier.weight(1f))
+            AddButton(Icons.Rounded.VideoCall, R.string.button_add_video_reference, onAddVideo, Modifier.weight(1f))
+            AddButton(Icons.Rounded.MusicNote, R.string.button_add_audio_reference, onAddAudio, Modifier.weight(1f))
+        }
+        if (references.isEmpty()) {
+            Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                Text(
+                    text = stringResource(R.string.label_r2v_hint),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    textAlign = TextAlign.Center,
+                    modifier = Modifier.padding(16.dp)
+                )
+            }
+        } else {
+            LazyVerticalGrid(
+                columns = GridCells.Adaptive(minSize = 96.dp),
+                modifier = Modifier.fillMaxSize().padding(top = 8.dp),
+                contentPadding = PaddingValues(bottom = 8.dp),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalArrangement = Arrangement.spacedBy(8.dp)
+            ) {
+                items(references, key = { it.id }) { item ->
+                    ReferenceCard(
+                        item = item,
+                        tags = tags[item.id].orEmpty().joinToString(" "),
+                        onClick = { onInsertTag(item) },
+                        onRemove = { onRemove(item.id) },
+                        onSoundChange = { onSoundChange(item.id, it) }
+                    )
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun AddButton(
+    icon: androidx.compose.ui.graphics.vector.ImageVector,
+    labelRes: Int,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    FilledTonalButton(onClick = onClick, modifier = modifier, contentPadding = PaddingValues(horizontal = 8.dp)) {
+        Icon(icon, contentDescription = null, modifier = Modifier.size(18.dp))
+        Text(
+            text = stringResource(labelRes),
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.padding(start = 4.dp)
+        )
+    }
+}
+
+/** A reference: its picture (or a note for audio), its tag; tapping it puts the tag in the prompt. */
+@Composable
+private fun ReferenceCard(
+    item: ReferenceItem,
+    tags: String,
+    onClick: () -> Unit,
+    onRemove: () -> Unit,
+    onSoundChange: (Boolean) -> Unit
+) {
+    val shape = RoundedCornerShape(16.dp)
+    val thumbnail = remember(item.thumbnail) { item.thumbnail?.asImageBitmap() }
+    Box(
+        modifier = Modifier
+            .aspectRatio(1f)
+            .clip(shape)
+            .background(MaterialTheme.colorScheme.surfaceContainerHighest)
+            .clickable(onClick = onClick)
+    ) {
+        if (thumbnail != null) {
+            Image(
+                bitmap = thumbnail,
+                contentDescription = item.name,
+                modifier = Modifier.fillMaxSize(),
+                contentScale = ContentScale.Crop
+            )
+        } else {
+            Column(
+                modifier = Modifier.fillMaxSize().padding(8.dp),
+                verticalArrangement = Arrangement.Center,
+                horizontalAlignment = Alignment.CenterHorizontally
+            ) {
+                Icon(Icons.Rounded.MusicNote, contentDescription = null, modifier = Modifier.size(28.dp))
+                Text(
+                    text = item.name,
+                    style = MaterialTheme.typography.labelSmall,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                    textAlign = TextAlign.Center
+                )
+            }
+        }
+        // The tag, as the prompt names the reference
+        Surface(
+            modifier = Modifier.align(Alignment.BottomStart).padding(4.dp),
+            shape = RoundedCornerShape(8.dp),
+            color = MaterialTheme.colorScheme.secondaryContainer.copy(alpha = 0.9f)
+        ) {
+            Text(
+                text = tags,
+                style = MaterialTheme.typography.labelSmall,
+                maxLines = 2,
+                modifier = Modifier.padding(horizontal = 6.dp, vertical = 2.dp)
+            )
+        }
+        IconButton(onClick = onRemove, modifier = Modifier.align(Alignment.TopEnd).size(32.dp)) {
+            Surface(shape = RoundedCornerShape(50), color = MaterialTheme.colorScheme.surface.copy(alpha = 0.8f)) {
+                Icon(
+                    Icons.Rounded.Close,
+                    contentDescription = stringResource(R.string.content_description_remove_reference),
+                    modifier = Modifier.padding(4.dp).size(16.dp)
+                )
+            }
+        }
+        if (item.kind == ReferenceKind.VIDEO && item.hasSound) {
+            IconButton(onClick = { onSoundChange(!item.withSound) }, modifier = Modifier.align(Alignment.TopStart).size(32.dp)) {
+                Surface(shape = RoundedCornerShape(50), color = MaterialTheme.colorScheme.surface.copy(alpha = 0.8f)) {
+                    Icon(
+                        if (item.withSound) Icons.Rounded.MusicNote else Icons.Rounded.MusicOff,
+                        contentDescription = stringResource(R.string.label_reference_video_sound),
+                        modifier = Modifier.padding(4.dp).size(16.dp)
+                    )
+                }
+            }
+        }
+    }
+}
