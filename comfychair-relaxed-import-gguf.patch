+/** How often the server's log is read while the viewer is open. */
+private const val POLL_MS = 1500L
+
+/**
+ * The ComfyUI server's console log, live: model loading, each sampling step with its progress bar, warnings and errors,
+ * as the server's terminal shows them. Read every 1.5 s while open; it follows new lines until scrolled up. Lines can
+ * be filtered, copied and shared.
+ */
+@Composable
+fun ServerLogDialog(onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    var lines by remember { mutableStateOf<List<String>>(emptyList()) }
+    var error by remember { mutableStateOf<String?>(null) }
+    var loaded by remember { mutableStateOf(false) }
+    var paused by remember { mutableStateOf(false) }
+    var filter by remember { mutableStateOf("") }
+    var showFilter by remember { mutableStateOf(false) }
+    val listState = rememberLazyListState()
+    var isFollowing by remember { mutableStateOf(true) }
+    val scope = rememberCoroutineScope()
+
+    val shown = remember(lines, filter) {
+        if (filter.isBlank()) lines else lines.filter { it.contains(filter, ignoreCase = true) }
+    }
+
+    val isAtBottom by remember {
+        derivedStateOf {
+            val last = listState.layoutInfo.visibleItemsInfo.lastOrNull()?.index ?: 0
+            val total = listState.layoutInfo.totalItemsCount
+            total == 0 || last >= total - 2
+        }
+    }
+    LaunchedEffect(isAtBottom) { if (isAtBottom) isFollowing = true }
+    LaunchedEffect(listState.firstVisibleItemIndex) { if (!isAtBottom && shown.isNotEmpty()) isFollowing = false }
+
+    // Read while open and not paused
+    LaunchedEffect(paused) {
+        while (!paused) {
+            val client = ConnectionManager.clientOrNull
+            if (client == null) {
+                error = context.getString(R.string.error_no_connection)
+            } else {
+                val (newLines, newError) = suspendCoroutine<Pair<List<String>?, String?>> { cont ->
+                    client.fetchServerLog { l, e -> cont.resume(l to e) }
+                }
+                if (newLines != null) {
+                    error = null
+                    if (newLines != lines) lines = newLines
+                } else {
+                    error = newError
+                }
+            }
+            loaded = true
+            delay(POLL_MS)
+        }
+    }
+    LaunchedEffect(shown.size) {
+        if (isFollowing && shown.isNotEmpty()) listState.scrollToItem(shown.size - 1)
+    }
+
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false)
+    ) {
+        Surface(color = MaterialTheme.colorScheme.surface, modifier = Modifier.fillMaxSize()) {
+            Column(Modifier.fillMaxSize().windowInsetsPadding(WindowInsets.safeDrawing)) {
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    modifier = Modifier.fillMaxWidth().padding(start = 4.dp, end = 4.dp, top = 8.dp, bottom = 8.dp)
+                ) {
+                    IconButton(onClick = onDismiss) {
+                        Icon(Icons.Rounded.Close, contentDescription = stringResource(R.string.content_description_close))
+                    }
+                    Text(
+                        stringResource(R.string.title_server_log),
+                        style = MaterialTheme.typography.titleLarge,
+                        modifier = Modifier.padding(start = 8.dp).weight(1f)
+                    )
+                    IconButton(onClick = { showFilter = !showFilter }) {
+                        Icon(Icons.Rounded.Search, contentDescription = stringResource(R.string.label_server_log_filter))
+                    }
+                    IconButton(onClick = { paused = !paused }) {
+                        Icon(
+                            if (paused) Icons.Rounded.PlayArrow else Icons.Rounded.Pause,
+                            contentDescription = stringResource(if (paused) R.string.button_server_log_resume else R.string.button_server_log_pause)
+                        )
+                    }
+                }
+                if (showFilter) {
+                    OutlinedTextField(
+                        value = filter,
+                        onValueChange = { filter = it },
+                        singleLine = true,
+                        label = { Text(stringResource(R.string.label_server_log_filter)) },
+                        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 4.dp)
+                    )
+                }
+                error?.let {
+                    Text(
+                        text = stringResource(R.string.error_server_log, it),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error,
+                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 4.dp)
+                    )
+                }
+
+                Box(Modifier.weight(1f).fillMaxWidth()) {
+                    if (shown.isEmpty()) {
+                        Text(
+                            text = stringResource(if (loaded) R.string.msg_server_log_empty else R.string.msg_server_log_loading),
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = MaterialTheme.colorScheme.onSurfaceVariant,
+                            modifier = Modifier.align(Alignment.Center).padding(24.dp)
+                        )
+                    } else {
+                        NoOverscrollContainer(modifier = Modifier.fillMaxSize()) {
+                            SelectionContainer {
+                                LazyColumn(
+                                    state = listState,
+                                    contentPadding = PaddingValues(horizontal = 12.dp, vertical = 8.dp),
+                                    modifier = Modifier.fillMaxSize()
+                                ) {
+                                    itemsIndexed(shown) { _, line -> ServerLogLine(line) }
+                                }
+                            }
+                        }
+                    }
+                    if (!isFollowing && shown.isNotEmpty()) {
+                        SmallFloatingActionButton(
+                            onClick = {
+                                scope.launch {
+                                    isFollowing = true
+                                    listState.scrollToItem(shown.size - 1)
+                                }
+                            },
+                            modifier = Modifier.align(Alignment.BottomEnd).padding(16.dp)
+                        ) {
+                            Icon(Icons.Rounded.VerticalAlignBottom, contentDescription = stringResource(R.string.debug_log_follow))
+                        }
+                    }
+                }
+
+                Row(
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                    modifier = Modifier.padding(16.dp)
+                ) {
+                    TextButton(
+                        onClick = {
+                            PrivacyUtils.copySensitiveText(context, "ComfyUI log", shown.joinToString("\n"))
+                            Toast.makeText(context, R.string.msg_copied_to_clipboard, Toast.LENGTH_SHORT).show()
+                        },
+                        enabled = shown.isNotEmpty()
+                    ) { Text(stringResource(R.string.button_copy)) }
+                    Button(
+                        onClick = {
+                            // The latest lines only: a share carries a limited amount of text
+                            val text = shown.takeLast(2000).joinToString("\n")
+                            val send = Intent(Intent.ACTION_SEND).apply {
+                                type = "text/plain"
+                                putExtra(Intent.EXTRA_TEXT, text)
+                            }
+                            context.startActivity(Intent.createChooser(send, null))
+                        },
+                        enabled = shown.isNotEmpty(),
+                        modifier = Modifier.weight(1f).height(56.dp)
+                    ) { Text(stringResource(R.string.button_share)) }
+                }
+            }
+        }
+    }
+}
+
+/** A line of the log, colored when it reads as an error or a warning. */
+@Composable
+private fun ServerLogLine(line: String) {
+    val lower = line.lowercase()
+    val color = when {
+        "error" in lower || "exception" in lower || "traceback" in lower -> MaterialTheme.colorScheme.error
+        "warn" in lower -> MaterialTheme.colorScheme.tertiary
+        else -> MaterialTheme.colorScheme.onSurfaceVariant
+    }
+    Text(
+        text = line.ifEmpty { " " },
+        style = MaterialTheme.typography.bodySmall,
+        fontFamily = FontFamily.Monospace,
+        color = color,
+        modifier = Modifier.padding(vertical = 1.dp)
+    )
+}
