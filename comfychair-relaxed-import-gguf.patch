+
+/** What the Reference to Video preview shows full size: the references or the result. */
+enum class ReferenceToVideoViewMode {
+    SOURCE,
+    PREVIEW
+}
+
+/**
+ * A reference picked for Reference to Video, kept as a file in the app's cache until it's removed.
+ *
+ * @param thumbnail The image itself or a video's first frame, scaled down; null for audio
+ * @param hasSound A video with a soundtrack
+ * @param withSound The soundtrack is passed on too (it then takes an <Audio N> tag)
+ */
+data class ReferenceItem(
+    val id: String,
+    val kind: ReferenceKind,
+    val file: File,
+    val extension: String,
+    val mimeType: String,
+    val name: String,
+    val thumbnail: Bitmap? = null,
+    val hasSound: Boolean = false,
+    val withSound: Boolean = false
+)
+
+/**
+ * The prompt tags of the references, numbered as MiniMax H3 presents them: <Picture N> by image, <Video N> by video,
+ * <Audio N> first for the videos' soundtracks (in video order), then for the standalone audio clips.
+ */
+fun List<ReferenceItem>.tags(): Map<String, List<String>> {
+    var pictures = 0
+    var videos = 0
+    var audios = 0
+    val tags = mutableMapOf<String, MutableList<String>>()
+    filter { it.kind == ReferenceKind.IMAGE }.forEach { tags.getOrPut(it.id) { mutableListOf() } += "<Picture ${++pictures}>" }
+    filter { it.kind == ReferenceKind.VIDEO }.forEach { item ->
+        val list = tags.getOrPut(item.id) { mutableListOf() }
+        if (item.withSound) list += "<Audio ${++audios}>"
+        list += "<Video ${++videos}>"
+    }
+    filter { it.kind == ReferenceKind.AUDIO }.forEach { tags.getOrPut(it.id) { mutableListOf() } += "<Audio ${++audios}>" }
+    return tags
+}
+
+/**
+ * UI state for the Reference to Video screen.
+ *
+ * Generation parameters and the video result are exposed directly through delegation.
+ */
+data class ReferenceToVideoUiState(
+    val params: GenerationParams = videoScreenDefaults,
+    val video: VideoResult = VideoResult(),
+    val availableWorkflows: List<WorkflowItem> = emptyList(),
+    val viewMode: ReferenceToVideoViewMode = ReferenceToVideoViewMode.SOURCE,
+    val references: List<ReferenceItem> = emptyList(),
+    val isUploading: Boolean = false
+) : CommonGenerationState by params, VideoResultState by video
+
+/**
+ * ViewModel for the Reference to Video screen: MiniMax H3 ref2va with up to 9 images, 3 videos and 3 audio clips as
+ * references, wired into the workflow's MiniMaxH3ReferenceToVideo node when generating.
+ *
+ * The references live in the app's cache while the app runs; they aren't restored after a restart.
+ */
+class ReferenceToVideoViewModel : BaseVideoGenerationViewModel<ReferenceToVideoUiState>() {
+
+    companion object {
+        const val OWNER_ID = "REFERENCE_TO_VIDEO"
+
+        const val MAX_IMAGES = 9
+        const val MAX_VIDEOS = 3
+        const val MAX_AUDIOS = 3
+
+        /** Largest reference file, as it's read whole when uploaded */
+        const val MAX_REFERENCE_BYTES = 100L * 1024 * 1024
+
+        private const val THUMB_MAX_PX = 512
+
+        /** MiniMax H3 scales reference images down to a 2048 px short edge at most (never up): nothing above it counts */
+        private const val IMAGE_MAX_SHORT_EDGE = 2048
+        private const val CACHE_DIR = "r2v_references"
+        private const val LOG_TAG = "ReferenceToVideo"
+    }
+
+    override val initialState = ReferenceToVideoUiState()
+
+    override val tag = "ReferenceToVideo"
+    override val ownerId = OWNER_ID
+    override val workflowType = WorkflowType.R2V
+    override val prefsName = "ReferenceToVideoFragmentPrefs"
+    override val videoFilePrefix = VideoUtils.FilePrefix.REFERENCE_TO_VIDEO
+    override val previewKey = MediaStateHolder.MediaKey.R2vPreview
+    override fun videoKey(promptId: String) = MediaStateHolder.MediaKey.R2vVideo(promptId)
+    override fun currentVideoPromptId() = MediaStateHolder.getCurrentR2vPromptId()
+    override fun clearCurrentVideoPromptId() = MediaStateHolder.clearCurrentR2vPromptId()
+    override fun defaultPositivePrompt() = SeasonalPrompts.getImageToVideoPrompt()
+
+    override fun ReferenceToVideoUiState.params() = params
+    override fun ReferenceToVideoUiState.withParams(params: GenerationParams) = copy(params = params)
+    override fun ReferenceToVideoUiState.video() = video
+    override fun ReferenceToVideoUiState.withVideo(video: VideoResult) = copy(video = video)
+    override fun ReferenceToVideoUiState.workflows() = availableWorkflows
+    override fun ReferenceToVideoUiState.withWorkflows(workflows: List<WorkflowItem>) = copy(availableWorkflows = workflows)
+
+    override fun onInitialize() {
+        super.onInitialize()
+        // Files of references from before a restart (the list itself isn't kept): nothing names them any more
+        val context = applicationContext ?: return
+        val kept = _uiState.value.references.map { it.file.name }.toSet()
+        viewModelScope.launch(Dispatchers.IO) {
+            File(context.cacheDir, CACHE_DIR).listFiles()?.filter { it.name !in kept }?.forEach { it.delete() }
+        }
+    }
+
+    override fun onClearShownMedia() {
+        super.onClearShownMedia()
+        clearReferences()
+    }
+
+    /** Ready with at least one image or video (audio alone isn't a reference MiniMax H3 can follow). */
+    override fun hasValidConfiguration(): Boolean {
+        val state = _uiState.value
+        return state.references.any { it.kind != ReferenceKind.AUDIO } && isReadyToGenerate(state.params)
+    }
+
+    fun onViewModeChange(mode: ReferenceToVideoViewMode) {
+        _uiState.update { it.copy(viewMode = mode) }
+    }
+
+    /** Put a reference's tag(s) at the end of the prompt. */
+    fun insertTag(item: ReferenceItem) {
+        val tags = _uiState.value.references.tags()[item.id]?.joinToString(" ") ?: return
+        val prompt = _uiState.value.params.positivePrompt
+        val separator = if (prompt.isEmpty() || prompt.endsWith(" ") || prompt.endsWith("\n")) "" else " "
+        onPositivePromptChange(prompt + separator + tags)
+    }
+
+    /** Pass a video's soundtrack on with it, or not. */
+    fun onReferenceSoundChange(id: String, withSound: Boolean) {
+        _uiState.update { state ->
+            state.copy(references = state.references.map { if (it.id == id && it.hasSound) it.copy(withSound = withSound) else it })
+        }
+    }
+
+    fun removeReference(id: String) {
+        val item = _uiState.value.references.firstOrNull { it.id == id } ?: return
+        _uiState.update { state -> state.copy(references = state.references.filterNot { it.id == id }) }
+        viewModelScope.launch(Dispatchers.IO) { item.file.delete() }
+    }
+
+    private fun clearReferences() {
+        val items = _uiState.value.references
+        _uiState.update { it.copy(references = emptyList()) }
+        viewModelScope.launch(Dispatchers.IO) { items.forEach { it.file.delete() } }
+    }
+
+    /** A file picked on the device as a reference of [kind]: copied to the cache, with a thumbnail where it has one. */
+    fun addReference(context: Context, uri: Uri, kind: ReferenceKind) {
+        val limitMessage = limitMessage(kind)
+        if (limitMessage != null) {
+            viewModelScope.launch { _events.emit(GenerationScreenEvent.ShowToast(limitMessage)) }
+            return
+        }
+        viewModelScope.launch(Dispatchers.IO) {
+            val item = try {
+                readReference(context, uri, kind)
+            } catch (e: Exception) {
+                DebugLogger.w(LOG_TAG, "Reference not read: ${e.javaClass.simpleName}")
+                null
+            }
+            if (item == null) {
+                _events.emit(GenerationScreenEvent.ShowToast(R.string.error_reference_unreadable))
+                return@launch
+            }
+            // Checked again: another pick may have filled the last place meanwhile
+            if (limitMessage(kind) != null) {
+                item.file.delete()
+                _events.emit(GenerationScreenEvent.ShowToast(limitMessage(kind)!!))
+                return@launch
+            }
+            _uiState.update { it.copy(references = it.references + item, viewMode = ReferenceToVideoViewMode.SOURCE) }
+        }
+    }
+
+    /** The message when no more references of [kind] fit; null while they do. */
+    private fun limitMessage(kind: ReferenceKind): Int? {
+        val count = _uiState.value.references.count { it.kind == kind }
+        return when (kind) {
+            ReferenceKind.IMAGE -> R.string.msg_reference_limit_images.takeIf { count >= MAX_IMAGES }
+            ReferenceKind.VIDEO -> R.string.msg_reference_limit_videos.takeIf { count >= MAX_VIDEOS }
+            ReferenceKind.AUDIO -> R.string.msg_reference_limit_audios.takeIf { count >= MAX_AUDIOS }
+        }
+    }
+
+    private suspend fun readReference(context: Context, uri: Uri, kind: ReferenceKind): ReferenceItem? {
+        val resolver = context.contentResolver
+        val name = resolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
+            if (cursor.moveToFirst() && !cursor.isNull(0)) cursor.getString(0) else null
+        } ?: uri.lastPathSegment ?: kind.name.lowercase()
+        val dir = File(context.cacheDir, CACHE_DIR).apply { mkdirs() }
+        val id = UUID.randomUUID().toString()
+
+        if (kind == ReferenceKind.IMAGE) {
+            // Decoded and stored as PNG: any format the device reads reaches the server in one it reads
+            val decoded = SourceUploads.decodeImage(context, uri) ?: return null
+            // No larger than the model reads it, so a photo isn't uploaded at full size for nothing
+            val shortEdge = minOf(decoded.width, decoded.height)
+            val bitmap = if (shortEdge > IMAGE_MAX_SHORT_EDGE) {
+                val longer = maxOf(decoded.width, decoded.height)
+                scaled(decoded, (longer.toLong() * IMAGE_MAX_SHORT_EDGE / shortEdge).toInt()).also {
+                    if (it !== decoded) decoded.recycle()
+                }
+            } else {
+                decoded
+            }
+            val file = File(dir, "$id.png")
+            file.outputStream().use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) }
+            val thumbnail = scaled(bitmap, THUMB_MAX_PX)
+            if (thumbnail !== bitmap) bitmap.recycle()
+            return ReferenceItem(id, kind, file, "png", "image/png", name, thumbnail)
+        }
+
+        val declaredSize = resolver.query(uri, arrayOf(OpenableColumns.SIZE), null, null, null)?.use { cursor ->
+            if (cursor.moveToFirst() && !cursor.isNull(0)) cursor.getLong(0) else null
+        }
+        if (declaredSize != null && declaredSize > MAX_REFERENCE_BYTES) return null
+        val mimeType = resolver.getType(uri) ?: if (kind == ReferenceKind.VIDEO) "video/mp4" else "audio/mpeg"
+        val extension = MimeTypeMap.getSingleton().getExtensionFromMimeType(mimeType)?.takeIf { it.isNotEmpty() }
+            ?: name.substringAfterLast('.', "").lowercase().takeIf { it.isNotEmpty() && it.length <= 5 }
+            ?: if (kind == ReferenceKind.VIDEO) "mp4" else "mp3"
+        val file = File(dir, "$id.$extension")
+        val copied = resolver.openInputStream(uri)?.use { input ->
+            file.outputStream().use { output ->
+                var total = 0L
+                val buffer = ByteArray(64 * 1024)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) break
+                    total += read
+                    if (total > MAX_REFERENCE_BYTES) return@use false
+                    output.write(buffer, 0, read)
+                }
+                true
+            }
+        } ?: false
+        if (!copied) {
+            file.delete()
+            return null
+        }
+
+        return if (kind == ReferenceKind.VIDEO) {
+            val thumbnail = VideoFrames.firstFrame(context, Uri.fromFile(file), THUMB_MAX_PX)
+            val hasSound = hasAudioTrack(file)
+            ReferenceItem(id, kind, file, extension, mimeType, name, thumbnail, hasSound = hasSound, withSound = hasSound)
+        } else {
+            ReferenceItem(id, kind, file, extension, mimeType, name)
+        }
+    }
+
+    private fun scaled(bitmap: Bitmap, maxPx: Int): Bitmap {
+        val longer = maxOf(bitmap.width, bitmap.height)
+        if (longer <= maxPx) return bitmap
+        val scale = maxPx.toFloat() / longer
+        return Bitmap.createScaledBitmap(bitmap, (bitmap.width * scale).toInt().coerceAtLeast(1),
+            (bitmap.height * scale).toInt().coerceAtLeast(1), true)
+    }
+
+    private fun hasAudioTrack(file: File): Boolean {
+        val extractor = MediaExtractor()
+        return try {
+            extractor.setDataSource(file.absolutePath)
+            (0 until extractor.trackCount).any {
+                extractor.getTrackFormat(it).getString(MediaFormat.KEY_MIME)?.startsWith("audio/") == true
+            }
+        } catch (_: Exception) {
+            false
+        } finally {
+            extractor.release()
+        }
+    }
+
+    /**
+     * Upload the references to ComfyUI and prepare the workflow with them.
+     */
+    suspend fun prepareWorkflow(): String? {
+        val client = comfyUIClient ?: return null
+        val context = applicationContext ?: return null
+
+        // Check connection before uploading
+        val connected = suspendCoroutine { cont ->
+            ConnectionManager.ensureConnection(context) { success ->
+                cont.resumeWith(Result.success(success))
+            }
+        }
+        if (!connected) return null  // Dialog already shown by ensureConnection
+
+        val state = _uiState.value
+        val p = state.params
+        if (state.references.none { it.kind != ReferenceKind.AUDIO }) {
+            _events.emit(GenerationScreenEvent.ShowToast(
+                if (state.references.isEmpty()) R.string.msg_no_references else R.string.msg_audio_needs_visual
+            ))
+            return null
+        }
+        if (p.hasErrors) return null
+        // A workflow without MiniMax H3's reference node would run without the references, as if they weren't there
+        val workflowJson = WorkflowManager.getWorkflowById(p.selectedWorkflowId)?.jsonContent.orEmpty()
+        if (!workflowJson.contains("\"MiniMaxH3ReferenceToVideo\"")) {
+            _events.emit(GenerationScreenEvent.ShowToast(R.string.error_r2v_no_reference_node))
+            return null
+        }
+
+        _uiState.update { it.copy(isUploading = true) }
+        return try {
+            val uploaded = mutableListOf<WorkflowManager.WorkflowReference>()
+            for (item in state.references) {
+                val bytes = withContext(Dispatchers.IO) { runCatching { item.file.readBytes() }.getOrNull() } ?: run {
+                    _events.emit(GenerationScreenEvent.ShowToast(R.string.error_reference_unreadable))
+                    return null
+                }
+                // Named by content: a reference sent before isn't sent again
+                val result = SourceUploads.bytes(client, "r2v_ref", bytes, item.extension, item.mimeType)
+                val filename = result.filename ?: run {
+                    if (!SourceUploads.alertIfConnection(context, result.failure)) {
+                        _events.emit(GenerationScreenEvent.ShowToast(R.string.error_upload_reference))
+                    }
+                    return null
+                }
+                uploaded += WorkflowManager.WorkflowReference(item.kind, filename, withSound = item.withSound)
+            }
+
+            WorkflowManager.prepareWorkflow(
+                p.selectedWorkflowId, withSubmittedSeed(p), WorkflowManager.WorkflowImages(references = uploaded)
+            )
+        } finally {
+            _uiState.update { it.copy(isUploading = false) }
+        }
+    }
+}
