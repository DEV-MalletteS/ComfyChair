+    /** A diffusion-model loader: ComfyUI's UNETLoader or any variant (UnetLoaderGGUF, UnetLoaderGGUFAdvanced, ...). */
+    fun isUnetLoader(classType: String): Boolean =
+        classType.equals("UNETLoader", ignoreCase = true) || classType.startsWith("UnetLoader", ignoreCase = true)
+
+    /**
+     * Remove every node whose class_type is in [classTypes], and every input wired to one of them.
+     * Returns null when the workflow has subgraph definitions (removal there is not supported).
+     */
+    fun removeNodes(jsonContent: String, classTypes: Set<String>): String? {
+        val root = JSONObject(jsonContent)
+        if (Subgraphs.definitionsOf(root) != null) return null
+        val nodes = root.optJSONObject("nodes") ?: root
+        val removed = mutableSetOf<String>()
+        for (id in nodes.keys().asSequence().toList()) {
+            val node = nodes.optJSONObject(id) ?: continue
+            if (node.optString("class_type") in classTypes) removed.add(id)
+        }
+        removed.forEach { nodes.remove(it) }
+        for (id in nodes.keys()) {
+            val inputs = nodes.optJSONObject(id)?.optJSONObject("inputs") ?: continue
+            val dangling = inputs.keys().asSequence().filter { key ->
+                val v = inputs.opt(key)
+                v is org.json.JSONArray && v.length() == 2 && v.optString(0) in removed
+            }.toList()
+            dangling.forEach { inputs.remove(it) }
+        }
+        return root.toString(2)
+    }
