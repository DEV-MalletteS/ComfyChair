+    /** Standard loader class <-> its ComfyUI-GGUF twin. */
+    private val GGUF_TWINS = mapOf(
+        "UNETLoader" to "UnetLoaderGGUF",
+        "CLIPLoader" to "CLIPLoaderGGUF",
+        "DualCLIPLoader" to "DualCLIPLoaderGGUF",
