+    /**
+     * The server's console log: what ComfyUI's terminal shows (loading, sampling steps with their progress bars,
+     * warnings, errors), from its /internal/logs/raw endpoint. Progress bars redrawn in place (carriage returns) are
+     * shown as their latest state, as a terminal shows them.
+     *
+     * The endpoint serves ComfyUI's own frontend and isn't a stable API: a server without it gives an error.
+     *
+     * @param callback The log's lines, or null and an error message
+     */
+    fun fetchServerLog(callback: (lines: List<String>?, error: String?) -> Unit) {
+        val baseUrl = getBaseUrl() ?: run {
+            callback(null, context?.getString(R.string.error_no_connection) ?: "No connection to server")
+            return
+        }
+        val request = Request.Builder().url("$baseUrl/internal/logs/raw").get().build()
+        httpClient.newCall(request).enqueue(object : okhttp3.Callback {
+            override fun onFailure(call: okhttp3.Call, e: IOException) {
+                callback(null, e.message ?: e.javaClass.simpleName)
+            }
+
+            override fun onResponse(call: okhttp3.Call, response: Response) {
+                response.use {
+                    if (!response.isSuccessful) {
+                        callback(null, "HTTP ${response.code}")
+                        return
+                    }
+                    try {
+                        val entries = JSONObject(response.body.string()).optJSONArray("entries") ?: JSONArray()
+                        val text = StringBuilder()
+                        for (i in 0 until entries.length()) text.append(entries.optJSONObject(i)?.optString("m").orEmpty())
+                        val lines = text.toString().split('\n').map { it.substringAfterLast('\r') }
+                        callback(lines.dropLastWhile { it.isEmpty() }, null)
+                    } catch (e: Exception) {
+                        callback(null, e.javaClass.simpleName)
+                    }
+                }
+            }
+        })
+    }
